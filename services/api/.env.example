# Comma-separated browser origins. Process environment overrides this file.
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Local demo administration only; empty disables admin APIs. Local setup generates a key.
STORE_ADMIN_TOKEN=

# Customer OAuth: each provider requires BOTH ID and secret; empty disables login.
CUSTOMER_WEB_ORIGIN=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
